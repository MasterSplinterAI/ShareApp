# Base URL of Lalia backend (without trailing slash)
LALIA_API_BASE_URL=https://lalia.cloud

# Shared worker secret matching BOT_WORKER_SECRET in livekit-app/backend/.env
BOT_WORKER_SECRET=replace-with-strong-random-secret

# STT provider ladder (matches production cloud agent: xAI primary -> Deepgram Nova-3 fallback)
STT_PROVIDER=xai
XAI_API_KEY=replace-with-xai-api-key
DEEPGRAM_API_KEY=replace-with-deepgram-api-key

# Worker identity & concurrency
BOT_WORKER_ID=lalia-bot-worker-1
MAX_CONCURRENT_SESSIONS=2
POLL_INTERVAL_MS=4000
LOBBY_TIMEOUT_MS=600000
ALONE_TIMEOUT_MS=90000
MAX_CALL_DURATION_MS=14400000

# Optional: Playwright storageState JSON path for a signed-in Google account (e.g. notetaker@lalia.cloud)
# GOOGLE_STORAGE_STATE_PATH=/secrets/google-bot-storage-state.json
HEADLESS=true
