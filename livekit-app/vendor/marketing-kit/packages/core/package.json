{
  "name": "@rhule/marketing-core",
  "version": "0.1.0",
  "description": "Codebase-aware AI Marketing, SEO Blog, Artwork, and Resend Email engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-snapshot.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/router.test.ts"
  },
  "dependencies": {
    "@rhule/marketing-shared": "file:../shared"
  }
}
