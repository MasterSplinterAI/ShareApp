{
  "name": "@rhule/marketing-react",
  "version": "0.1.0",
  "description": "MarketingOpsConsole \u2014 Copilot, Blog Studio, Email Studio, Audiences, Analytics",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-snapshot.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rhule/marketing-shared": "file:../shared"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
