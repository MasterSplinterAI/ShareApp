{
  "name": "@quill/support-shared",
  "version": "0.1.0",
  "description": "Types and Zod schemas for support-kit (zero runtime deps beyond zod)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/ticket.test.ts",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint yet'"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
