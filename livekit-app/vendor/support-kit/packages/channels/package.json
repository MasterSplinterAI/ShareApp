{
  "name": "@quill/support-channels",
  "version": "0.1.0",
  "description": "Optional channel adapters (email, Telegram, Slack) for support-kit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/telegram.test.ts",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint yet'"
  },
  "dependencies": {
    "@quill/support-shared": "file:../shared"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
