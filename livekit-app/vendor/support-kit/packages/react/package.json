{
  "name": "@quill/support-react",
  "version": "0.1.0",
  "description": "SupportLauncher + headless hooks for support-kit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react --external react-dom",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/*.test.tsx",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint yet'"
  },
  "dependencies": {
    "@quill/support-shared": "file:../shared"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
