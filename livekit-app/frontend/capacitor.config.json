{
  "appId": "cloud.lalia.app",
  "appName": "Lalia",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "lalia.cloud",
      "*.lalia.cloud",
      "*.livekit.cloud"
    ]
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "backgroundColor": "#090d16"
  },
  "android": {
    "backgroundColor": "#090d16",
    "allowMixedContent": false
  }
}
