# Simplified configuration using only OpenAI for STT + translation (emergency fallback mode)

# LiveKit Configuration (same as your backend)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# OpenAI API (for STT and Translation)
OPENAI_API_KEY=your_openai_api_key_here

# Agent Configuration
STT_PROVIDER=openai
LLM_PROVIDER=openai
AGENT_NAME=translation-bot
LOG_LEVEL=INFO
