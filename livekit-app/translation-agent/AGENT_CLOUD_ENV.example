# Copy these into LiveKit Cloud → Agents → translation-cloud-prod → Environment / secrets.
# Never commit real values. Matches `transcription_only_agent.py` (see startup log banner).

# --- LiveKit ---
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# LIVEKIT_API_KEY=<livekit generates>
# LIVEKIT_API_SECRET=<livekit generates>
# LIVEKIT_CLOUD=true

# --- Build traceability (recommended) ---
# Set to `git rev-parse HEAD` when you deploy, or any unique tag (logged at worker startup).
AGENT_BUILD_REF=v2026-xx-xx-xxxxxxx

# --- Speech-to-text (production: Deepgram nova-3) ---
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Deepgram END_OF_SPEECH (ms silence). 400 is a good default.
DEEPGRAM_ENDPOINTING_MS=400
# Finalize bubble after no new/changed transcript for this long (default 1200ms).
DEEPGRAM_STT_IDLE_MS=1200

# Silero VAD — higher activation_threshold = less background noise triggering speech.
# Presets: quiet | normal | noisy | ultra_noisy (override with VAD_PRESET).
VAD_PRESET=normal
VAD_ACTIVATION_THRESHOLD=0.58
VAD_MIN_SILENCE_SEC=1.1

# --- Fallback STT credentials (recommended in Cloud) ---
# OpenAI gpt-4o-transcribe as emergency fallback (set STT_PROVIDER=openai to activate).
OPENAI_API_KEY=

# --- Translation captions (cheap / low-latency default) ---
LLM_PROVIDER=openai
# Translation model (pinned; default gpt-4.1-mini) + sampling/timeout knobs.
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
# Per-attempt budget for one translation call (connect + full stream); 1 retry on failure.
LLM_TIMEOUT_SEC=6.0

# --- Live translation while speaking (simultaneous-MT local agreement) ---
# Foreign-language readers see stable translated text during speech instead of
# waiting for Deepgram is_final. Disable to fall back to final-only translation.
INTERIM_TRANSLATION_ENABLED=true
# Debounce between interim translation calls per target language (ms).
INTERIM_TRANSLATION_MIN_INTERVAL_MS=600

# --- Translation quality/consistency ---
# Rolling (source → target) utterance pairs carried across turns (0 disables).
TRANSLATION_CONTEXT_PAIRS=3
# LRU cache for repeated utterances (0 disables).
TRANSLATION_CACHE_SIZE=512
# Comma-separated terms the LLM must keep verbatim (brand/product names).
# TRANSLATION_KEYTERMS=ShareApp,LiveKit
# Comma-separated Deepgram nova-3 keyterm prompts (boosts STT accuracy on domain terms).
# DEEPGRAM_KEYTERMS=ShareApp,LiveKit

# Optional (agent identity)
AGENT_NAME=translation-cloud-prod

# --- Applying to LiveKit ---
# Do NOT pass all vars as one comma-separated lk --secrets string; commas break parsing.
# Use: lk agent deploy --secrets "STT_PROVIDER=deepgram" --secrets "LLM_PROVIDER=openai"
# or: lk agent update-secrets --secrets-file path/to/non-secret-vars-only.txt plus dashboard for keys
