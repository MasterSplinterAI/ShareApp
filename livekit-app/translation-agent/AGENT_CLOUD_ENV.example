# Copy these into LiveKit Cloud → Agents → translation-cloud-prod → Environment / secrets.
# Never commit real values. Matches `transcription_only_agent.py` (see startup log banner).

# --- LiveKit ---
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# LIVEKIT_API_KEY=<livekit generates>
# LIVEKIT_API_SECRET=<livekit generates>
# LIVEKIT_CLOUD=true

# --- Build traceability (recommended) ---
# Set to `git rev-parse HEAD` when you deploy, or any unique tag (logged at worker startup).
AGENT_BUILD_REF=v2026-xx-xx-xxxxxxx

# --- Speech-to-text (production: Deepgram nova-3) ---
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Deepgram END_OF_SPEECH (ms silence). 400 is a good default.
DEEPGRAM_ENDPOINTING_MS=400
# Finalize bubble after no new/changed transcript for this long (default 1200ms).
DEEPGRAM_STT_IDLE_MS=1200
# Legacy non-Deepgram only: delay before history finalize when speech_final is unavailable.
CAPTION_UTTERANCE_END_DELAY_SEC=1.5
# xAI (disabled unless STT_PROVIDER=xai):
# XAI_API_KEY=
# XAI_STT_ENDPOINTING_MS=1800

# Silero VAD — higher activation_threshold = less background noise triggering speech.
# Presets: quiet | normal | noisy | ultra_noisy (override with VAD_PRESET).
VAD_PRESET=normal
VAD_ACTIVATION_THRESHOLD=0.58
VAD_MIN_SILENCE_SEC=1.1

# --- Fallback STT credentials (recommended in Cloud) ---
# Grok STT auto-falls back for langs outside XAI_SUPPORTED_LANGS or on errors.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- Translation captions (cheap / low-latency default) ---
# openai → openai.LLM() (~gpt-4o-mini) per transcription segment; sufficient for caption translation for most workloads.
LLM_PROVIDER=openai
# Only if LLM_PROVIDER=xai:
XAI_LLM_MODEL=grok-4.20-non-reasoning

# Optional (agent identity)
AGENT_NAME=translation-cloud-prod

# --- Applying to LiveKit (read this) ---
# Do NOT pass all vars as one comma-separated lk --secrets string; commas break parsing.
# Use: lk agent deploy --secrets "STT_PROVIDER=xai" --secrets "LLM_PROVIDER=openai"
# or: lk agent update-secrets --secrets-file path/to/non-secret-vars-only.txt plus dashboard for keys
