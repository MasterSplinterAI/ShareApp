{
  "name": "livekit-backend",
  "version": "1.0.0",
  "description": "LiveKit backend for international conferencing app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "build:support-kit": "node ../vendor/support-kit/scripts/build-consumer-snapshot.mjs",
    "predev": "npm run build:ops-sdk && npm run build:support-kit && npm run build:marketing-kit",
    "build:ops-sdk": "node ../vendor/ops-sdk/scripts/build.mjs",
    "build:marketing-kit": "node ../vendor/marketing-kit/scripts/build-snapshot.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@rhule/marketing-core": "file:../vendor/marketing-kit/packages/core",
    "@rhule/marketing-shared": "file:../vendor/marketing-kit/packages/shared",
    "@quill/support-channels": "file:../vendor/support-kit/packages/channels",
    "@quill/support-core": "file:../vendor/support-kit/packages/core",
    "@quill/support-shared": "file:../vendor/support-kit/packages/shared",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.1.0",
    "marked": "^18.0.5",
    "multer": "^2.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "sqlite3": "^5.1.6",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.0",
    "@rhule/ops-sdk": "file:../vendor/ops-sdk"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "esbuild": "^0.25.0",
    "typescript": "5.6.3",
    "@types/node": "20.19.27"
  }
}
