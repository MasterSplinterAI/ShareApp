# LiveKit Backend — environment variables
# Copy to .env and fill in real values.

# LiveKit credentials
LIVEKIT_URL=wss://your-server.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# JWT (required — backend refuses to start without this)
# Generate: openssl rand -hex 32
JWT_SECRET_V2=

# Translation API
TRANSLATION_API_KEY=replace-with-api-key
TRANSLATION_API_PROVIDER=grok
TRANSLATION_API_URL=https://api.x.ai/v1/chat/completions
TRANSLATION_MODEL=grok-4.20-non-reasoning

# Database
USE_DATABASE_CACHE=false
V2_DB_PATH=

# Stripe
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# URLs
FRONTEND_URL=http://localhost:5174
NETWORK_URL=http://localhost:5174
BACKEND_BASE_URL=http://localhost:3001
PUBLIC_FRONTEND_BASE_URL=
STAGING_FRONTEND_URL=

# Email (Resend) — preferred config is Admin → Communications → Email delivery
# (stored in the platform DB, encrypted at rest). The vars below are OPTIONAL
# env fallbacks used only when the matching admin setting is not stored.
RESEND_API_KEY=
MAIL_FROM=Lalia <no-reply@lalia.cloud>
EMAIL_ENABLED=true
# Inbound RSVP signing secret (whsec_...). Optional override — prefer storing it
# in Admin → Communications. Admin value takes precedence over this env var.
RESEND_WEBHOOK_SECRET=
# Calendar organizer domain. Optional override — prefer Admin → Communications.
# Admin value takes precedence; otherwise defaults to the MAIL_FROM domain.
PARLEY_ICS_ORGANIZER_DOMAIN=

# Object storage — preferred config is Admin → Storage (DB overrides these).
# Default is local disk under ./uploads (branding + org files at uploads/v2/<orgId>/).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-2
# Custom endpoint for Cloudflare R2 / MinIO (leave blank for AWS S3)
STORAGE_S3_ENDPOINT=
# Auto-on when endpoint is set; set true/false to force
STORAGE_S3_FORCE_PATH_STYLE=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PREFIX=
# Optional dedicated key for AES-GCM of Admin secrets (defaults to JWT_SECRET_V2)
# SETTINGS_ENCRYPTION_KEY=

# Phase 1: Cost tracking + webhooks
LIVEKIT_WEBHOOK_VERIFY=true
COST_EVENT_SECRET=replace-with-32-byte-hex

# Overage settlement cron (optional; ms between runs, e.g. 3600000 = hourly)
# V2_OVERAGE_SETTLEMENT_INTERVAL_MS=3600000
